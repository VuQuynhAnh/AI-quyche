# --- Cấu hình Database (PostgreSQL) — users, documents, đoạn văn bản + vector embedding ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=ai_quyche
PGUSER=postgres
PGPASSWORD=postgres

# --- Cấu hình MongoDB — lưu lịch sử hội thoại (conversations/messages) ---
# Local: mongodb://localhost:27017/ai_quyche_chat
# Docker: docker run -d -p 27017:27017 --name mongo mongo:7
# Atlas (cloud, có gói free): mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/ai_quyche_chat
MONGODB_URI=mongodb://localhost:27017/ai_quyche_chat

# --- Cấu hình xác thực ---
JWT_SECRET=doi-chuoi-bi-mat-nay-truoc-khi-deploy
JWT_EXPIRES_IN=7d

# --- Cấu hình Google Gemini API ---
# Lấy API key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Cấu hình server ---
PORT=4000
CORS_ORIGIN=http://localhost:5173
