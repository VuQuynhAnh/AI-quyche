# Sao chép file này thành ".env" (cùng thư mục backend/) rồi điền giá trị thật.
# KHÔNG commit file .env lên git.

# ---------- Server ----------
PORT=4000
# Domain frontend được phép gọi API (VD: https://ten-app.vercel.app). Bỏ trống = cho phép tất cả.
CORS_ORIGIN=

# Số proxy đứng trước backend, để đọc đúng IP người dùng (chấm công bằng Wi-Fi).
# Bỏ trống: tự dùng 1 khi chạy trên Render, 0 khi chạy ở máy local.
TRUST_PROXY_HOPS=

# ---------- PostgreSQL (cần extension pgvector) ----------
PGHOST=localhost
PGPORT=5432
PGDATABASE=ai_quyche
PGUSER=postgres
PGPASSWORD=postgres

# ---------- MongoDB (lưu lịch sử chat) ----------
MONGODB_URI=mongodb://localhost:27017/ai_quyche_chat

# ---------- Redis (cache, KHÔNG bắt buộc) ----------
# Cache các API đọc dữ liệu lớn, ít thay đổi (bảng lương đã chốt, bảng công
# tháng đã chốt, file CSV bảng lương, số liệu dashboard). Để trống = tắt cache.
REDIS_URL=

# ---------- Cloudinary (lưu ảnh đại diện, KHÔNG bắt buộc) ----------
# Gói free tại https://cloudinary.com — copy "API environment variable" ở
# Dashboard, dạng cloudinary://<api_key>:<api_secret>@<cloud_name>.
# Để trống = lưu ảnh trên ổ đĩa server (backend/uploads/, mất khi deploy lại trên Render free).
CLOUDINARY_URL=

# ---------- Google Gemini ----------
# Lấy key miễn phí tại https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Không bắt buộc — để trống dùng mặc định trong code
GEMINI_CHAT_MODEL=
GEMINI_EMBEDDING_MODEL=
# Phải khớp VECTOR(768) trong schema.sql
GEMINI_EMBEDDING_DIMENSIONS=768

# ---------- Đăng nhập (JWT) ----------
# Đặt chuỗi ngẫu nhiên dài khi chạy thật
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# ---------- Debug ----------
# Đặt 1 để log mọi câu SQL
DEBUG_SQL=0
